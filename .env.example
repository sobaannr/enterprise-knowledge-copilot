# Gemini API credentials. Keep secrets outside version control.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# SQLite creates its file, tables and fictional data automatically.
COPILOT_DATABASE_URL=sqlite:///./copilot.db
COPILOT_SEED_DEMO=true
# Replace these before exposing the service. Never commit real tokens.
COPILOT_ADMIN_TOKEN=demo-admin-change-me
COPILOT_READER_TOKEN=demo-reader-change-me
COPILOT_TENANT=acme
COPILOT_RETRIEVAL_BACKEND=gemini
COPILOT_GEMINI_DIMENSIONS=768
COPILOT_GEMINI_REWRITE=true
COPILOT_GEMINI_RERANK=true
COPILOT_PROPOSAL_TTL_MINUTES=60
COPILOT_GENERATION_BACKEND=gemini
# MCP forwards this token to the API; it cannot approve proposals.
COPILOT_API_URL=http://127.0.0.1:8000
COPILOT_MCP_TOKEN=demo-reader-change-me

# Optional USD per million tokens: fill your actual provider rates.
# Unknown prices/usage produce null costs, not invented estimates.
# COPILOT_INPUT_USD_PER_MILLION=
# COPILOT_OUTPUT_USD_PER_MILLION=
# COPILOT_EMBEDDING_USD_PER_MILLION=
